# Copy to .env and fill in, then run scripts/gen-seed.sh.
#
#   cp .env.example .env
#
# Blank values below are generated: gen-seed.sh writes the tenant identifiers and
# admin credentials, resolve-tags.sh pins the image tags, and run.sh generates the
# OIDC client ids/secrets (or gen-seed.sh uses whatever is here). Choose your own
# MONGO_PASS / RABBITMQ_PASS before first start — they are baked into the volumes.
#
# See README-local.md for the full sequence.

# ---------------------------------------------------------------------------
# blocks-infra — local development environment.
# Single source of truth for credentials and ports (see README "Configure your
# local application"). run.sh sources this file and composes the
# BlocksSecret__* connection strings from the base variables below.
# ---------------------------------------------------------------------------

# ---- MongoDB --------------------------------------------------------------
MONGO_USER=blocks
MONGO_PASS=
MONGO_HOST_PORT=27018

# ---- Redis ----------------------------------------------------------------
REDIS_HOST_PORT=6379

# ---- RabbitMQ -------------------------------------------------------------
RABBITMQ_USER=blocks
RABBITMQ_PASS=
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ---- Application config (consumed literally by .NET services) -------------
BlocksSecret__RootDatabaseName=BlocksRootDb
BlocksSecret__LogDatabaseName=BlocksLogDb
BlocksSecret__MetricDatabaseName=BlocksMetricDb
BlocksSecret__TraceDatabaseName=BlocksTraceDb
BlocksSecret__EnableHsts=false
# 1 = local secret provider (reads from env), 2 = Azure Key Vault
BLOCKS_VAULT_TYPE=1

# ---- Host / deployment ----------------------------------------------------
# run.sh auto-detects the host IP with `ip route` / `hostname -I`, which do not
# exist on macOS — pin it here so APP_* connection strings are built correctly.
HOST_IP=
DOMAIN=localtest.me
LETSENCRYPT_EMAIL=test@email.com

# ---- Image tags (apps profile only; unused for `--profile infra`) ---------
OS_TAG=          # pinned by scripts/resolve-tags.sh
IAM_TAG=          # pinned by scripts/resolve-tags.sh
DATA_TAG=          # pinned by scripts/resolve-tags.sh
AGENTS_TAG=          # pinned by scripts/resolve-tags.sh
LOGIC_TAG=          # pinned by scripts/resolve-tags.sh
LOCALIZATION_TAG=          # pinned by scripts/resolve-tags.sh
MONITOR_TAG=          # pinned by scripts/resolve-tags.sh
RELEASE_TAG=          # pinned by scripts/resolve-tags.sh
STUDIO_TAG=          # pinned by scripts/resolve-tags.sh
UTILITIES_TAG=          # pinned by scripts/resolve-tags.sh

# ---- Per-service URLs (override the https://<svc>.<DOMAIN> default) -------
# Ports are kept because there is no TLS terminator in front of these yet.
# Drop the ports once nginx-proxy is serving *.localtest.me on 443.
OS_URL=https://os.localtest.me
IAM_URL=https://iam.localtest.me
DATA_URL=https://data.localtest.me
LOGIC_URL=https://logic.localtest.me
LOCALIZATION_URL=https://localization.localtest.me
STUDIO_URL=https://studio.localtest.me
RELEASE_URL=https://release.localtest.me
MONITOR_URL=https://monitor.localtest.me
AGENTS_URL=https://agents.localtest.me
UTILITIES_URL=https://utilities.localtest.me

# ---- OIDC client credentials (stable; consumed by configure.sh) ----------
OS_CLIENT_ID=
OS_CLIENT_SECRET=
IAM_CLIENT_ID=
IAM_CLIENT_SECRET=
DATA_CLIENT_ID=
DATA_CLIENT_SECRET=
LOGIC_CLIENT_ID=
LOGIC_CLIENT_SECRET=
LOCALIZATION_CLIENT_ID=
LOCALIZATION_CLIENT_SECRET=
STUDIO_CLIENT_ID=
STUDIO_CLIENT_SECRET=
RELEASE_CLIENT_ID=
RELEASE_CLIENT_SECRET=
MONITOR_CLIENT_ID=
MONITOR_CLIENT_SECRET=
AGENTS_CLIENT_ID=
AGENTS_CLIENT_SECRET=
UTILITIES_CLIENT_ID=
UTILITIES_CLIENT_SECRET=

# ---- Root tenant + tenant DB connection (consumed by configure.js) -------
ROOT_TENANT_ID=f080a1bea04280a72149fd689d50a48c
TENANT_DB_CONNECTION_STRING=
TENANT_ITEM_ID=
TENANT_SALT=
TENANT_CERT_PASSWORD=
ADMIN_EMAIL=admin@localtest.me
ADMIN_PASSWORD=
BCRYPT_COST=8

# ---- Compose profiles ------------------------------------------------------
# Selected here so plain `docker compose up -d` works. The upstream `apps`
# profile is deliberately NOT used: it includes studio and agents, whose images
# are not published on Docker Hub, and one 404 fails the whole command. These
# are upstream's own per-service profiles.
#
# Kept deliberately small: the podman VM has 5 CPUs / 3814MiB, and each emulated
# .NET service takes ~430MB. All 16 apps need ~6.9GB and the machine thrashes.
# os + iam is the minimum for a working console login. Add services one at a
# time (data, logic, localization, release, monitor, utilities) as needed, or
# give the VM more memory: podman machine stop && podman machine set -m 8192.
COMPOSE_PROFILES=infra,local-edge,os,iam
