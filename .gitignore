# Generated by configure.sh — contains client-specific values (domain, secrets).
# Run:  bash run.sh  to regenerate before docker compose up.
/configure.js
.claude/
-

# Local environment — credentials, ports, generated connection strings.
# .env.tmp is the intermediate gen-seed.sh and resolve-tags.sh write when
# rewriting a value; an interrupted run leaves a full copy of .env behind.
.env
.env.tmp

# BSON dumps restored by mongodb-seed. Contain OIDC client secrets and JWT
# certificate material. Either exported from a populated instance with
# DumpDb.sh, or built locally by scripts/make-dumps.sh.
/BlocksRootDb/
/BlocksConfiguration/

# Locally-signed TLS material for *.localtest.me (regenerate with mkcert).
certs/

# Generated by scripts/gen-seed.sh from .env and scripts/permissions.txt — edits
# here are discarded on the next run. seed-rootdb.js additionally carries the
# tenant's PKCS#12 private key and the admin BCrypt hash.
scripts/seed-*.js

# Key material, wherever it lands. Everything above is ignored by path, so this
# is the backstop for anything written somewhere unexpected.
*.key
*.pem
*.pfx
*.p12

.DS_Store
